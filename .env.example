# ==============================================================================
# FRONTEND (Vite / Client-Side)
# Only variables prefixed with VITE_ are exposed to the browser.
# Never place service role keys or administrative secrets in VITE_ variables.
# ==============================================================================

# Supabase Client Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Firebase Cloud Messaging (Web Push) Client Configuration
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-web-app-id
VITE_FIREBASE_VAPID_KEY=your-firebase-vapid-public-key

# Application URL
VITE_APP_URL=http://localhost:3000

# ==============================================================================
# BACKEND (Serverless Functions / API Routes / Node.js Server)
# These variables run exclusively on the server and are NEVER exposed to the browser.
# ==============================================================================

# Supabase Server-Side Configuration (Bypasses RLS for admin operations)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini API
GEMINI_API_KEY=your-google-gemini-api-key

# Hotmart Integration (Webhook verification token)
HOTMART_WEBHOOK_TOKEN=your-hotmart-webhook-token

# Firebase Admin SDK (Server-Side Push Notifications)
# Provide either the raw JSON string or base64-encoded JSON of your Service Account
FIREBASE_SERVICE_ACCOUNT=your-firebase-service-account-json-or-base64
# Or legacy FCM Server Key:
FIREBASE_SERVER_KEY=your-legacy-firebase-server-key

# General Server Configuration
APP_URL=http://localhost:3000
INTERNAL_API_SECRET=your-internal-api-secret

